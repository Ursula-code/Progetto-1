# Esercizio Punto 1
def valori_in_rubrica(rubrica):
  
  #iterazione attraverso il dizionario 
  for nome, dati in rubrica.items():      #.items() serve per accedere alla chiave principale e ai dati
    
    #creo una lista di stringhe formattate per i dati personali tramite un ciclo for
    dettagli = [f"'{chiave}':{valore}" for chiave, valore in dati.items()]
    
    #unisco tutti i dettagli 
    print(f"'{nome}':{','.join(dettagli)}")


# Esercizio Punto 2
def lista_delle_età(rubrica):

  #estrazione delle età 
  lista_eta = []
  for nome, dati in rubrica.items():
    lista_eta.append(dati['età'])
  
  #riordino la lista
  lista_eta.sort()
  print(lista_eta)

  # stampo i nomi associandoli alle età gia ordinate
  print("\n Nomi ordinati per età:")
  for eta in lista_eta:
    for nome, dati in rubrica.items():
      if dati['età'] == eta:
        print(f"{nome}: {eta} anni")
  return lista_eta


