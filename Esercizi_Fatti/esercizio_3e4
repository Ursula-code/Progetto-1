import sys          #'''sys.argv è una lista fornita dal modulo sys che contiene argomenti passati da riga di comando 
 #qui viene usato posizionalmente accedendo a sys.argv[1] per recuperare direttamente la chiave di ricerca inserita'''
def cerca_per_chiave(rubrica, chiave=None):
    # Se la chiave non è passata come parametro, la legge da sys.argv (Punto 5)
    if chiave is None:
        if len(sys.argv) < 2:
            print("Errore: devi passare una chiave valida")
            return
        chiave = sys.argv[1]

    print(f"\n--- Valori associati alla chiave '{chiave}' ---")

    # Questo blocco (il ciclo for) RIMANE IDENTICO a come lo hai già scritto:
    for nome, dati in rubrica.items():
        if chiave in dati:
            print(f"{nome}: {dati[chiave]}")
        else:
            print(f"La chiave '{chiave}' non esiste per {nome}.")


