# Esercizio: 4 - Punto 2
import json
def salva_json(rubrica, nome_file="rubrica.json"):
    with open(nome_file, "w") as file:
        # json.dump prende il dizionario 'rubrica' e lo scrive nel file in formato JSON
        # indent=4 serve per formattare il file in modo bello e leggibile
        json.dump(rubrica, file, indent=4)
    print(f"File '{nome_file}' generato con successo.")


# Esercizio 4 - Punto 3
def leggi_json(nome_file="rubrica.json"):
    with open(nome_file, "r") as file:
        # json.load legge il file JSON e lo riconverte in un dizionario Python
        dati = json.load(file)
    
    print("--- CONTENUTO DEL FILE JSON ---")
    print(dati)


