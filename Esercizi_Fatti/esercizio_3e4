# Esercizio: 4 - Punto 1
def salva_txt(rubrica, nome_file="rubrica.txt"):
    with open(nome_file, "w") as file:
        for nome, dati in rubrica.items():
            # Formattiamo ogni riga esattamente come richiesto dall'esempio:
            # Paolino Paperino, 9, giugno, 1934, 89, M, paolino.paperino@disney.org
            riga = f"{nome}, {dati['giorno']}, {dati['mese']}, {dati['anno']}, {dati['età']}, {dati['sesso']}, {dati['mail']}\n"
            file.write(riga)
    print(f"File '{nome_file}' generato con successo.")

