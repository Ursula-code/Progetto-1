# Esercizio Punto 3
def trova_soluzioni_uniche(num_soluzioni_desiderate=10, dimensione_scacchiera=8):

    soluzioni_uniche = []
    tempi_impiegati = []

    # "stato_base" crea la lista [0, 1, 2, 3, 4, 5, 6, 7] che ci assicura che non ci siano mai regine sulla stessa riga o colonna.
    stato_base = list(range(dimensione_scacchiera))

    print(
        f"Inizio ricerca di {num_soluzioni_desiderate} soluzioni UNICHE (senza duplicati)...\n"
    )

    # Il ciclo continua a girare finché la nostra lista "soluzioni_uniche" non contiene esattamente 10 elementi.
    while len(soluzioni_uniche) < num_soluzioni_desiderate:
        
        tempo_inizio = time.time()

        # Ciclo interno per generare tentativi finché non ne trova uno valido
        while True:

            scacchiera_tentativo = stato_base.copy()
            random.shuffle(scacchiera_tentativo)

            # controllo che la scacchiera rispetti la regola delle diagonali 
            if e_valida(scacchiera_tentativo):

                # L'operatore "not in" (non in) controlla se questa specifica scacchiera NON è già stata salvata prima.
                if scacchiera_tentativo not in soluzioni_uniche:
                    tempo_fine = time.time()
                    durata = tempo_fine - tempo_inizio

                    # Aggiungo la nuova soluzione unica e il tempo impiegato alle liste
                    soluzioni_uniche.append(scacchiera_tentativo)
                    tempi_impiegati.append(durata)

                    # Calcola a che numero di soluzione siamo arrivati usando "len(soluzioni_uniche)"
                    numero_soluzione = len(soluzioni_uniche)

                    print(
                        f"Soluzione Unica {numero_soluzione}: {scacchiera_tentativo} | Tempo: {durata:.6f}s"
                    )

                    break

    # calcola la media dei tempi
    tempo_medio = sum(tempi_impiegati) / len(tempi_impiegati)
    
    print("\n--- RISULTATI PUNTO 3 ---")
    
    print(
        f"Tempo medio per trovare una soluzione UNICA: {tempo_medio:.6f} secondi"
    )

    return soluzioni_uniche, tempo_medio



