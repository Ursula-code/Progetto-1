# Esercizio Punto 4
def conta_ripetizioni_soluzioni(
    num_soluzioni_totali=50, dimensione_scacchiera=8
):
    # Un DIZIONARIO "{}" è un contenitore speciale che associa delle "chiavi" a dei "valori".
    # Qui usiamo come chiave la configurazione della scacchiera e come valore il conteggio di quante volte l'abbiamo trovata.
    conteggio_soluzioni = {}

    stato_base = list(range(dimensione_scacchiera))

    print(
        f"Inizio ricerca di {num_soluzioni_totali} soluzioni valide per analizzare le ripetizioni...\n"
    )

    # Facciamo un ciclo "for" per trovare un totale di 50 soluzioni valide (alcune nuove, altre ripetute).
    for i in range(1, num_soluzioni_totali + 1):

        # Ciclo interno che continua a mescolare finché non trova UNA soluzione valida
        while True:
            scacchiera_tentativo = stato_base.copy()
            random.shuffle(scacchiera_tentativo)

            #controlla che la posizione delle regine sia valida
            if e_valida(scacchiera_tentativo):

                # * Le liste in Python non possono essere usate come "chiavi" nei dizionari perché possono cambiare, dunque usiamo "tuple()" per convertire la lista [0, 1, ...] in una tupla (0, 1, ...), che è immutabile (non si può più modificare).
                scacchiera_chiave = tuple(scacchiera_tentativo)

                # verifica se questa scacchiera è presente nel dizionario 
                if scacchiera_chiave in conteggio_soluzioni:

                    conteggio_soluzioni[scacchiera_chiave] += 1

                else:
                    # * Se è la primissima volta che la incontriamo, la registriamo nel dizionario impostando il contatore a 1.
                    conteggio_soluzioni[scacchiera_chiave] = 1

                break

    print("--- RISULTATI PUNTO 4 ---")
    print(
        f"Su {num_soluzioni_totali} soluzioni trovate in totale, ecco le ripetizioni per ciascuna:\n"
    )

    # ".items()" ci permette di scorrere il dizionario ottenendo sia la scacchiera ("soluzione") sia quante volte è apparsa ("volte")
    numero = 1
    for soluzione, volte in conteggio_soluzioni.items():
        # Convertiamo la tupla di nuovo in lista solo per mantenerla visivamente ordinata come prima
        print(f"Soluzione {numero}: {list(soluzione)} -> Trovata {volte} volte")
        numero += 1

    print(
        f"\nIn totale sono state individuate {len(conteggio_soluzioni)} soluzioni uniche diverse."
    )

    return conteggio_soluzioni


