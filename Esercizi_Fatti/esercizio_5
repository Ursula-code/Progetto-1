def trova_scacchiera_massima_sotto_soglia(limite_secondi=15.0):
    # Partiamo dalla scacchiera di dimensione N = 4 (la più piccola scacchiera con soluzioni valide).
    N = 4

    # salvo in questa variabile l'ultimo valore di N che ha completato la ricerca in meno di 15 secondi
    ultimo_N_valido = N

    print(
        f"Inizio test progressivo di N... Ricerca della dimensione massima risolvibile entro {limite_secondi}s\n"
    )

    # continua finché non si supera il limite di tempo
    while True:
        
        stato_base = list(range(N))

        tempo_inizio = time.time()
        tentativi = 0

        # Ciclo di ricerca della prima soluzione valida per la dimensione N corrente.
        while True:
            tentativi += 1

            scacchiera_tentativo = stato_base.copy()
            random.shuffle(scacchiera_tentativo)

            if e_valida(scacchiera_tentativo):

                tempo_fine = time.time()
                durata = tempo_fine - tempo_inizio

                # Stampiamo i dettagli per la dimensione N appena completata.
                print(
                    f"Scacchiera {N:2d}x{N:<2d} | Soluzione trovata in: {durata:8.4f} secondi | Tentativi: {tentativi}"
                )
                break

        # verifica il limite di tempo (SOGLIA 15 SECONDI):
        if durata > limite_secondi:
            print(
                f"\n[!] La scacchiera {N}x{N} ha impiegato {durata:.2f}s, superando il limite di {limite_secondi}s!"
            )
            # Usciamo dal ciclo principale "while True" per arrestare l'aumento di N.
            break
        else:
            #Se la durata è inferiore a 15 secondi, aggiorniamo "ultimo_N_valido" con il valore attuale di N.
            ultimo_N_valido = N
            # Incrementiamo N di +1 per testare la dimensione successiva nel prossimo ciclo.
            N += 1

    print("\n--- RISULTATO PUNTO 6 ---")
    print(
        f"La dimensione massima di lato N per cui si trova 1 soluzione in meno di {limite_secondi}s è: N = {ultimo_N_valido} (Scacchiera {ultimo_N_valido}x{ultimo_N_valido})"
    )

    return ultimo_N_valido


