# * FUNZIONE PER LA ROTAZIONE DI 90 GRADI:
def ruota_90(scacchiera):
    N = len(scacchiera)
    # * Creiamo una lista vuota di dimensione N che conterrà la nuova scacchiera ruotata.
    nuova_scacchiera = [0] * N

    for riga, col in enumerate(scacchiera):
        # * La nuova riga diventa la vecchia colonna ("col").
        # * La nuova colonna diventa (N - 1 - riga).
        nuova_scacchiera[col] = N - 1 - riga

    return nuova_scacchiera


# * FUNZIONE CHE GENERA TUTTE E 4 LE ROTAZIONI SIMMETRICHE (0°, 90°, 180°, 270°):
def ottieni_tutte_rotazioni(scacchiera):
    # * 0 gradi: la scacchiera originale.
    rot_0 = scacchiera

    # * 90 gradi: ruotiamo di 90° la scacchiera originale.
    rot_90 = ruota_90(rot_0)

    # * 180 gradi: ruotiamo di ulteriori 90° quella a 90°.
    rot_180 = ruota_90(rot_90)

    # * 270 gradi: ruotiamo di ulteriori 90° quella a 180°.
    rot_270 = ruota_90(rot_180)

    # * Restituiamo le 4 configurazioni ruotate dentro una lista.
    return [rot_0, rot_90, rot_180, rot_270]


def trova_soluzioni_uniche_con_rotazioni(num_soluzioni_uniche=5, dimensione_scacchiera=8):
    # salverà le 5 soluzioni uniche trovate casualmente.
    soluzioni_base = []

    # terrà traccia di TUTTE le rotazioni di tutte le soluzioni trovate, in modo da non accettare soluzioni che siano semplici rotazioni di quelle già viste!
    tutte_rotazioni_registrate = set()

    stato_base = list(range(dimensione_scacchiera))

    print(
        f"Inizio ricerca di {num_soluzioni_uniche} soluzioni 'uniche' e delle rispettive 4 rotazioni simmetriche...\n"
    )

    # Continuiamo finché non troviamo 5 soluzioni base del tutto indipendenti
    while len(soluzioni_base) < num_soluzioni_uniche:

        scacchiera_tentativo = stato_base.copy()
        random.shuffle(scacchiera_tentativo)

        #controllo che la disposizione sia valida sulle diagonali 
        if e_valida(scacchiera_tentativo):
            # * Convertiamo la scacchiera in "tupla" congelata per poterla confrontare con l'insieme "set()"
            chiave_tentativo = tuple(scacchiera_tentativo)

            # La scacchiera NON deve essere già apparsa né come soluzione originale né come rotazione di altre!
            if chiave_tentativo not in tutte_rotazioni_registrate:

                # Calcoliamo le 4 rotazioni simmetriche per la soluzione appena trovata.
                rotazioni = ottieni_tutte_rotazioni(scacchiera_tentativo)

                # Salviamo la soluzione originale trovata.
                soluzioni_base.append(scacchiera_tentativo)

                # Registra tutte le 4 versioni ruotate dentro il set per evitare che in futuro vengano accettate come "nuove".
                for r in rotazioni:
                    tutte_rotazioni_registrate.add(tuple(r))

                num = len(soluzioni_base)
                print(
                    f"=== SOLUZIONE UNICA {num}: {scacchiera_tentativo} ==="
                )
                print(f"  ->   0° (originale): {rotazioni[0]}")
                print(f"  ->  90° rotazione  : {rotazioni[1]}")
                print(f"  -> 180° rotazione  : {rotazioni[2]}")
                print(f"  -> 270° rotazione  : {rotazioni[3]}\n")

    return soluzioni_base



