# Il parametro "N" rappresenta il lato della scacchiera
def risolvi_regine_generalizzato(N, num_soluzioni_desiderate=1):

    soluzioni_trovate = []
    tempi_impiegati = []
    lista_tentativi = []

   # adesso la lista arriva a una dimensione di N  
    stato_base = list(range(N))

    print(
        f"\nInizio ricerca di {num_soluzioni_desiderate} soluzione/i su una scacchiera {N}x{N}...\n"
    )

    # * Ciclo per trovare il numero di soluzioni richieste dall'utente.
    for i in range(1, num_soluzioni_desiderate + 1):
        tempo_inizio = time.time()
        tentativi = 0

        while True:
            tentativi += 1

            scacchiera_tentativo = stato_base.copy()
            random.shuffle(scacchiera_tentativo)

            # Verifichiamo la validità della scacchiera N x N
            if e_valida(scacchiera_tentativo):
                tempo_fine = time.time()
                durata = tempo_fine - tempo_inizio

                soluzioni_trovate.append(scacchiera_tentativo)
                tempi_impiegati.append(durata)
                lista_tentativi.append(tentativi)

                print(
                    f"Soluzione {i}: {scacchiera_tentativo} | Tentativi: {tentativi} | Tempo: {durata:.6f}s"
                )
                break

    # calcolo i dati medi finali
    tempo_medio = sum(tempi_impiegati) / len(tempi_impiegati)
    tentativi_medi = sum(lista_tentativi) / len(lista_tentativi)

    print(f"\n--- RISULTATI SCACCHIERA {N}x{N} ---")
    print(
        f"Tentativi medi per trovare una soluzione: {tentativi_medi:.1f} tentativi"
    )
    print(
        f"Tempo medio per trovare una soluzione: {tempo_medio:.6f} secondi"
    )

    return soluzioni_trovate, tentativi_medi, tempo_medio



