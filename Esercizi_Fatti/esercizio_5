# Esercizio Punto 2
def trova_soluzioni_con_tentativi(num_soluzioni_desiderate=10, dimensione_scacchiera=8):

    soluzioni_trovate=[]
    tempi_impiegati=[]
    lista_tentativi=[]
    
    #è una lista ordinata di numeri unici, si usa come modello iniziale per garantire che ogni regina sia posizionata su una riga e un acolonna distinte prima di permutare
    stato_base = list(range(dimensione_scacchiera))

    print(
        f"Inizio ricerca di {num_soluzioni_desiderate} soluzioni con conteggio dei tentativi...\n"
    )

    # il ciclo conta le 10 soluzioni che voglio trovare
    for i in range(1, num_soluzioni_desiderate + 1):

        tempo_inizio = time.time()

        # Servirà per contare quanti tentativi errati facciamo
        tentativi = 0

        while True:
            # aumente il contatore tentativi di 1
            tentativi += 1

            # ".copy()" fa una copia pulita della lista di partenza [0,1,2,3,4,5,6,7].
            scacchiera_tentativo = stato_base.copy()

            # mescola in modo completamente casuale gli elementi della lista appena copiata
            random.shuffle(scacchiera_tentativo)

            # Passiamo la scacchiera mescolata alla ricetta "e_valida()" scritta in alto.
            if e_valida(scacchiera_tentativo):
                
                tempo_fine = time.time()
                durata = tempo_fine - tempo_inizio

                # salvo la scacchiera valida, il tempo impiegato e i tentativi totali fatti nelle relative liste.
                soluzioni_trovate.append(scacchiera_tentativo)
                tempi_impiegati.append(durata)
                lista_tentativi.append(tentativi)

                print(
                    f"Soluzione {i}: {scacchiera_tentativo} | Tentativi: {tentativi} | Tempo: {durata:.6f}s"
                )

                break

    # "sum()" somma tutti i numeri presenti dentro una lista, calcola la media dividendo la somma totale per il numero di elementi "len()"
    tempo_medio = sum(tempi_impiegati) / len(tempi_impiegati)
    tentativi_medi = sum(lista_tentativi) / len(lista_tentativi)

    # * Stampiamo la sezione finale dei risultati statistici.
    print("\n--- RISULTATI ---")
    print(
        f"Tentativi medi per trovare una soluzione: {tentativi_medi:.1f} tentativi"
    )
    print(
        f"Tempo medio per trovare una soluzione: {tempo_medio:.6f} secondi"
    )

    
    return soluzioni_trovate, tentativi_medi, tempo_medio



