import random
import time




# Esercizio punto 1
def e_valida(scacchiera):
    n = len(scacchiera)
    for i in range(n):
        for j in range(i + 1, n):
            #abs() calcola i valori assoluti, in questo modo calcolo le distanze 
            if abs(scacchiera[i] - scacchiera[j]) == abs(i - j):        # se la distanza tra le righe è uguale a quella tra le colonne le regine sono sulla stessa diagonale 
                return False
    return True


def trova_soluzioni_permutazioni(
    num_soluzioni_desiderate=10, dimensione_scacchiera=8
):
    soluzioni_trovate = []
    tempi_impiegati = []

    stato_base = list(range(dimensione_scacchiera))

    print(
        f"Inizio ricerca di {num_soluzioni_desiderate} soluzioni tramite permutazioni..."
    )

    for i in range(1, num_soluzioni_desiderate + 1):
        tempo_inizio = time.time()

        while True:
            scacchiera_tentativo = stato_base.copy()
            random.shuffle(scacchiera_tentativo)

            if e_valida(scacchiera_tentativo):
                tempo_fine = time.time()
                durata = tempo_fine - tempo_inizio

                soluzioni_trovate.append(scacchiera_tentativo)
                tempi_impiegati.append(durata)

                print(
                    f"soluzione {i}: {scacchiera_tentativo} | Trovato in: {durata:.6f} secondi"
                )
                break

    # Calcolo e stampa del tempo medio (fuori dal for)
    tempo_medio = sum(tempi_impiegati) / len(tempi_impiegati)
    print("\n--- Risultati ---")
    print(
        f"Tempo medio per trovare una soluzione: {tempo_medio:.6f} secondi."
    )

    return soluzioni_trovate, tempo_medio


